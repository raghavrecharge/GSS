# Production database (use either a MySQL DSN or the private SQLite default).
GSS_DATABASE_DSN=mysql:host=127.0.0.1;dbname=gss;charset=utf8mb4
GSS_DATABASE_USER=
GSS_DATABASE_PASSWORD=

# Initial administrator allowed to request the one-time setup link.
GSS_ADMIN_EMAIL=administrator@example.com
GSS_PUBLIC_ORIGIN=https://gss.example.com

# Exactly 32 random bytes encoded as base64. Never commit a real value.
GSS_PII_KEY=BASE64_ENCODED_32_BYTE_KEY

# Optional private directory used by the SQLite fallback; keep outside public_html.
GSS_DATA_DIR=/private/path/gss-data
